---
interface Props {
  title?: string
}
const { title = 'NYC Ferry Delay Prediction' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="NYC Ferry operational delay prediction dashboard" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/nycferry-musa.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Oswald:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-ferry-dark-blue text-white font-sans flex flex-col h-screen overflow-hidden">
    <slot />
  </body>
</html>
